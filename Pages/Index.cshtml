@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/index.css" />
</head>
<body>
    @if (TempData["SuccessMessage"] != null)
    {
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
    }

    @if (Model.IsMedico)
    {
    <p>Você está logado como <strong>Médico</strong>.</p>
    }
    else if (Model.IsEnfermeiro)
    {
    <p>Você está logado como <strong>Enfermeiro</strong>.</p>
    }
    else if (Model.IsAdmin)
    {
    <p>Você está logado como <strong>Administrador</strong>.</p>
    }
    else
    {
    <p>Você não tem um papel definido.</p>
    }

    <div class="care-container">
        <div class="care-header">
            <h1>Atendimentos</h1>
            <form method="get">
                <input class="searchbar" type="text" name="SearchTerm" value="@Model.SearchTerm" placeholder="Pesquisar por nome, ID ou data" />
            </form>

        </div>

        <div class="card-container">

            @* Para ADMIN - todos atendimentos *@
            @if (Model.IsAdmin)
                {
            <h2>Todos os atendimentos</h2>
            <div class="card-content">
                @foreach (var card in Model.TodosAtendimentosAdmin)
                    {
                <partial name="_AtendimentoCard" model="card" />
                    }
            </div>
                }





            @* Para MÉDICO e ENFERMEIRO - atendimentos preenchíveis e não preenchíveis *@
            @if (Model.IsMedico || Model.IsEnfermeiro)
            {
            <h2>Pendentes</h2>
            <div class="card-content mb-4">
                @foreach (var card in Model.AtendimentosPreenchiveis)
                    {
                <partial name="_AtendimentoCard" model="card" />
                    }
            </div>

            <h2>Outros atendimentos</h2>
            <div class="card-content">
                @foreach (var card in Model.AtendimentosNaoPreenchiveisPaginados)
                    {
                <partial name="_AtendimentoCard" model="card" />
                    }
            </div>

            @if (Model.TotalPages > 1)
{
            <nav class="pagination">
                <ul>
                    @for (int i = 1; i <= Model.TotalPages; i++)
            {
                    <li class="@(i == Model.PageNumber ? "active" : "")">
                        <a href="?PageNumber=@i&SearchTerm=@Model.SearchTerm">@i</a>
                    </li>
            }
                </ul>
            </nav>
}


            }


        </div>

            <div class="buttons-container">
                <button asp-area="" asp-page="/Privacy">Consultar Atendimentos</button>
                <a class="ceub-button" asp-area="" asp-page="/Pacient">Novo atendimento</a>
            </div>
        </div>
</body>
</html>

@section Scripts {
    <script>
        setTimeout(() => {
            const alert = document.querySelector('.alert-success');
            if (alert) alert.style.display = 'none';
        }, 4000);
    </script>
}
