@page
@model PostoUNICEUB.Pages.LoginModel

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <title>Login</title>
    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
        }

        .login-page {
            display: flex;
            height: 100vh;
        }

        .login-image {
            flex: 1;
            background-color: #eee;
        }

            .login-image img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

        .login-form-container {
            flex: 1;
            background-color: white;
            display: flex;
            flex-direction: column;
            justify-content: center;
            padding: 3rem 4rem;
        }

        .login-title {
            text-align: center;
            font-size: 2rem;
            color: #5d2c7a;
            font-weight: bold;
            margin-bottom: 2rem;
        }

        .form-group {
            margin-bottom: 1.5rem;
        }

        label {
            display: block;
            font-weight: bold;
            margin-bottom: 0.5rem;
        }

        input {
            width: 100%;
            padding: 0.75rem;
            border: 1px solid #d1b2d6;
            border-radius: 4px;
            font-size: 1rem;
        }

        button {
            width: 100%;
            padding: 0.75rem;
            background-color: #5d2c7a;
            color: white;
            border: none;
            border-radius: 6px;
            font-weight: bold;
            font-size: 1rem;
            cursor: pointer;
        }

            button:hover {
                background-color: #4b2261;
            }

        .text-danger {
            color: red;
            margin-top: 1rem;
            text-align: center;
        }
        .login-image {
            flex: 1;
            position: relative;
            overflow: hidden;
        }

            .login-image img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                display: block;
            }

        .image-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(93, 44, 122, 0.5); /* roxo com 50% de opacidade */
            z-index: 1;
        }

    </style>
</head>
<body>
    <div class="login-page">
        <div class="login-image">
            <img src="~/assets/login.png" alt="Login" />
            <div class="image-overlay"></div>
        </div>


        <div class="login-form-container">
            <h2 class="login-title">LOGIN</h2>

            <form method="post">
                <div class="form-group">
                    <label for="email">E-mail</label>
                    <input asp-for="Email" id="email" />
                </div>

                <div class="form-group">
                    <label for="senha">Senha</label>
                    <input asp-for="Senha" id="senha" type="password" />
                </div>

                <button type="submit">Entrar</button>
                <p class="text-danger">@Model.Erro</p>
            </form>
        </div>
    </div>
</body>
</html>
