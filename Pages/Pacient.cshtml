@page
@model PostoUNICEUB.Pages.PacientModel
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/index.css">
    <link rel="stylesheet" href="~/css/pacient.css">
</head>
<body>
    <div class="pacient-container">
        <h1>Pacientes</h1>

        <div class="pacient-content">
            <form method="get" class="search-pacient">
                <input class="searchbar" type="text" name="SearchTerm" value="@Model.SearchTerm" placeholder="Pesquisar por nome ou ID">
                <button type="submit">Pesquisar</button>
            </form>
            @if (!string.IsNullOrEmpty(Model.SearchTerm))

{
    if (Model.ListaPacientes.Any())
    {

            <div class="pacients-container">
                @foreach (var paciente in Model.ListaPacientes)
            {
                if (paciente is Aluno aluno)
                {
                <form method="post" asp-page-handler="IniciarAtendimento">
                    <div class="pacient-card">
                        <div>
                            <p>Aluno</p>
                            <h2>@aluno.Paciente.nmPaciente</h2>
                            <p>RA: @aluno.ra</p>
                        </div>
                        <input type="hidden" name="PacienteId" value="@aluno.Paciente.idPaciente" />
                        <button type="submit">Iniciar</button>
                    </div>
                </form>
                }
                else if (paciente is Colaborador colaborador)
                {
                <form method="post" asp-page-handler="IniciarAtendimento">
                    <div class="pacient-card">
                        <div>
                            <p>Tipo: Colaborador</p>
                            <h2>@colaborador.Paciente.nmPaciente</h2>
                            <p>Matrícula: @colaborador.matricula</p>
                        </div>
                        <input type="hidden" name="PacienteId" value="@colaborador.Paciente.idPaciente" />
                        <button type="submit">Iniciar</button>
                    </div>
                </form>
                }
                else if (paciente is Paciente externo)
                {
                <form method="post" asp-page-handler="IniciarAtendimento">
                    <div class="pacient-card">
                        <div>
                            <h2>@externo.nmPaciente</h2>
                            <p>Tipo: Externo</p>
                        </div>
                        <input type="hidden" name="PacienteId" value="@externo.idPaciente" />
                        <button type="submit">Iniciar</button>
                    </div>
                </form>
                }
                }
            </div>
            }else{
            <h3>Paciente não encontrado</h3>
            }
            }

            <a class="ceub-button" asp-page="/NewPacient">Cadastrar Paciente</a>

        </div>

    </div>
    </div>
</body>
</html>
@if (Request.Query.ContainsKey("success"))
{
<div id="success-message" class="alert-success">
    Paciente cadastrado com sucesso!
</div>
}
@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const message = document.getElementById("success-message");
            if (message) {
                message.style.display = "block";
                setTimeout(() => {
                    message.style.display = "none";
                }, 4000); // Oculta após 4 segundos
            }
        });
    </script>
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
}

