@page
@model PostoUNICEUB.Pages.Treatment.DiagnosisModel
@{
    ViewData["Title"] = "Diagnóstico do Atendimento";
    bool isReadonly = Model.readonlyMode;
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/index.css">
    <link rel="stylesheet" href="~/css/diagnosis.css">
</head>
<body>
    <h1 style="color:#43054E; text-align: center; margin-bottom: 16px">Diagnóstico do Atendimento</h1>

    <strong>Paciente:</strong> @Model.Atendimento?.Paciente?.nmPaciente</p>
    <p><strong>Número atendimento:</strong> @Model.idAtendimento</p>
    <div class="diagnosis-container">

        <form method="post">
            <div class="form-container">
                <div class="observations-dg">

                    <div class="diagnostics-list">
                        @foreach (var diagnostico in Model.Diagnosticos)
                        {
                            var isChecked = Model.DiagnosticosMarcados.Contains(diagnostico.idDiagnostico);
                        <div>
                            <input type="checkbox"
                                   name="SelectedDiagnosticos"
                                   value="@diagnostico.idDiagnostico"
                                   @(isChecked ? "checked" : "")
                                   @(Model.IsReadOnly ? "disabled" : "") />
                            <label>@diagnostico.diagnostico</label>
                        </div>
                        }
                    </div>
                </div>

                <div class="presc-nu">
                    @for (int i = 0; i < Model.PrescricoesPadrao.Count; i++)
{
                    var textoPreenchido = i < Model.PrescricoesExistentes.Count
                        ? Model.PrescricoesExistentes[i].anotacao
                        : "";

                    <div class="diagnostico-item">
                        <label for="anotacao-@i">@Model.PrescricoesPadrao[i]</label>
                        <textarea id="anotacao-@i"
                                  name="anotacoes[@i]"
                                  rows="3"
                                  @(Model.IsReadOnly ? "readonly" : "")>@textoPreenchido</textarea>
                    </div>
}

                </div>
            </div>

            <div class="form-actions">
                @if (!Model.IsReadOnly )
            {
                <button type="submit" class="ceub-button">Salvar</button>
            }else{
                <a class="ceub-button" asp-page="/Treatment/Record" asp-route-idAtendimento="@Model.idAtendimento" asp-route-IsReadOnly="true">Seguir</a>

            }

            </div>

        </form>
    </div>
</body>
</html>
