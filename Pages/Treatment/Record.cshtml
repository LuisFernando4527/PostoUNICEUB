@page
@model PostoUNICEUB.Pages.Treatment.RecordModel

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/site.css">
    <link rel="stylesheet" href="~/css/record.css">
</head>
<body>
    <h1 style="color:#43054E; text-align: center; margin-bottom: 16px">Prontuário</h1>

    <div class="record-header">
        <div >
            <p><strong>Paciente:</strong> @Model.NomePaciente</p>
            <p><strong>Número atendimento:</strong> @Model.idAtendimento</p>

        </div>
        <a class="ceub-button" target="_blank" asp-page="/Treatment/Diagnosis" asp-route-idAtendimento="@Model.idAtendimento" asp-route-IsReadOnly="true">Visualizar Diagnóstico</a>

    </div>

        <form method="post">
    <div class="prescricao-item">
            <div class="form-group">
                <label asp-for="Prontuario.qp">Queixa Principal (QP):</label>
                <textarea class="mb-4" asp-for="Prontuario.qp" rows="3"></textarea>
            </div>

            <div class="form-group">
                <label asp-for="Prontuario.hda">História da Doença Atual (HDA):</label>
                <textarea class="mb-4" asp-for="Prontuario.hda" rows="3"></textarea>
            </div>

            <div class="form-group">
                <label asp-for="Prontuario.hpp">História Patológica Pregressa (HPP):</label>
                <textarea class="mb-4" asp-for="Prontuario.hpp" rows="3"></textarea>
            </div>

            <div class="form-group">
                <label asp-for="Prontuario.exameFisico">Exame Físico:</label>
                <textarea class="mb-4" asp-for="Prontuario.exameFisico" rows="5"></textarea>
            </div>

            <div class="form-group">
                <label asp-for="Prontuario.hd">Hipótese Diagnóstica (HD):</label>
                <textarea class="mb-4" asp-for="Prontuario.hd" rows="3"></textarea>
            </div>

            <div class="form-group">
                <label asp-for="Prontuario.conduta">Conduta:</label>
                <textarea class="mb-4" asp-for="Prontuario.conduta" rows="5"></textarea>
            </div>
    </div>

    <div class="button-group">
        @if (!Model.IsReadOnly ){
        <a class="ceub-button" asp-page="/Treatment/Diagnosis" asp-route-idAtendimento="@Model.idAtendimento">Voltar</a>
        <button type="submit" class="ceub-button">Cadastrar</button>
                    }else{

        <a class="ceub-button" asp-page="/Treatment/Diagnosis" asp-route-idAtendimento="@Model.idAtendimento" asp-route-IsReadOnly="true">Voltar</a>
        <a class="ceub-button " asp-page="/Treatment/MedicalPrescription" asp-route-idAtendimento="@Model.idAtendimento" asp-route-IsReadOnly="true">Seguir</a>

                    }
    </div>
    </form>



</body>
</html>

<script>
    //Atrubuir readonly quando for apenas visualização do prontuário
  window.onload = function() {
      var readOnly = @Model.IsReadOnly.ToString().ToLower();
      console.log(readOnly)
    if(readOnly) {
      document.querySelectorAll('textarea').forEach(function(t) {
        t.setAttribute('readonly', 'readonly');
      });
    }
  }
</script>
