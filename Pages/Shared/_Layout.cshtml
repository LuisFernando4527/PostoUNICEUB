<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PostoUNICEUB</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PostoUNICEUB.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="header-container">
            <div class="logo-container">
                <img class="logo" src="//salaonline.ceub.br/pluginfile.php/1/theme_ceub/logo1/1723752951/MarcaCEUB-TelaM.png">

            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2024 - PostoUNICEUB - <a asp-area="" asp-page="/Privacy">Privacy</a>
            &copy; 2024 - PostoUNICEUB - <a asp-area="" asp-page="/Index">aq</a>
            &copy; 2024 - PostoUNICEUB - <a asp-area="" asp-page="/NewPacient">aq</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>